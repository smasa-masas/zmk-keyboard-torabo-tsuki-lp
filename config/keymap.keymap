#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <13 14>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <26 25>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <21 22>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans  &trans            &trans    &trans    &trans          &trans                                         &trans       &trans  &trans     &trans            &trans                &trans
&trans  &kp Q             &kp W     &kp E     &kp R           &kp T                                          &kp Y        &kp U   &kp I      &kp O             &kp P                 &trans
&trans  &kp A             &kp S     &kp D     &kp F           &kp G        &trans            &trans          &kp H        &kp J   &kp K      &kp L             &kp SEMI              &trans
&trans  &mt LEFT_SHIFT Z  &kp X     &kp C     &kp V           &kp B        &kp LANGUAGE_1    &kp LANGUAGE_2  &kp N        &kp M   &kp COMMA  &kp DOT           &mt RIGHT_SHIFT FSLH  &trans
&trans  &kp LCTRL         &kp LGUI  &kp LALT  &kp LANGUAGE_2  &lt 2 SPACE  &lt 1 LANGUAGE_1  &kp BACKSPACE   &lt 3 ENTER  &trans  &trans     &lt 4 LEFT_SHIFT  &kp RCTRL             &trans
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &mkp RCLK  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp LCLK  &trans     &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans            &trans      &trans      &trans                         &trans           &trans  &trans  &trans  &trans            &trans
&trans  &kp F4  &kp LS(NUMBER_2)  &kp LS(N6)  &kp LS(N8)  &kp LS(N9)                     &kp LS(KP_PLUS)  &kp N7  &kp N8  &kp N9  &kp LS(KP_MINUS)  &trans
&trans  &kp N1  &kp N2            &kp N3      &kp N4      &kp LS(MINUS)  &trans  &trans  &kp KP_MULTIPLY  &kp N4  &kp N5  &kp N6  &kp KP_SLASH      &trans
&trans  &kp N6  &kp N7            &kp N8      &kp N9      &kp N0         &trans  &trans  &kp N0           &kp N1  &kp N2  &kp N3  &kp DOT           &trans
&trans  &trans  &trans            &trans      &trans      &trans         &trans  &trans  &trans           &trans  &trans  &trans  &trans            &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans    &trans  &trans                        &trans  &trans          &trans          &trans             &trans                &trans
&trans  &kp F1  &kp F2  &kp F3    &kp F4  &out OUT_USB                  &trans  &kp LC(PG_UP)   &kp UP_ARROW    &kp LC(PAGE_DOWN)  &kp LG(LS(S))         &trans
&trans  &kp F6  &kp F7  &kp F8    &kp F9  &out OUT_BLE  &trans  &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT          &trans                &trans
&trans  &trans  &trans  &kp SEMI  &trans  &bt BT_NXT    &trans  &trans  &trans  &trans          &trans          &trans             &kp C_BRIGHTNESS_INC  &trans
&trans  &trans  &trans  &trans    &trans  &trans        &trans  &trans  &trans  &trans          &trans          &trans             &kp C_BRI_DEC         &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans
            >;
        };
    };
};
